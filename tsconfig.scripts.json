{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["scripts/gamedata/**/*.ts", "scripts/generate-game-data.ts", "scripts/generate-og-images.ts", "src/shared/gamedata/types.ts"],
  "exclude": ["scripts/gamedata/**/__tests__/**"]
}
