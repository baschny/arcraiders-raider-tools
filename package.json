{
  "name": "raider-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Unified ARC Raiders tools collection",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "npm run generate:items && npm run generate:quests && npm run generate:hideout && npm run generate:projects-quartermaster && npm run generate:server-mappings && npm run generate:schedule",
    "generate:quests": "./scripts/generate-quest-data.sh",
    "generate:items": "npx tsx ./scripts/generate-items.ts",
    "generate:hideout": "npx tsx ./scripts/generate-hideout.ts",
    "generate:server-mappings": "npx tsx ./scripts/generate-server-mappings.ts",
    "generate:maps-localizations": "node ./scripts/generate-map-localizations.js",
    "generate:map-events-localizations": "node ./scripts/generate-map-event-localizations.js",
    "generate:schedule": "npm run generate:maps-localizations && npm run generate:map-events-localizations && node ./scripts/generate-schedule-data-from-map-conditions.js",
    "generate:projects-quartermaster": "npx tsx ./scripts/generate-quartermaster-projects.ts",
    "generate:maps": "node ./scripts/generate-maps-data.mjs",
    "generate:game-data": "npx tsx ./scripts/generate-game-data.ts",
    "generate:item-icons": "npx tsx ./scripts/generate-item-icons.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.16",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.5.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "clipper2-js": "^1.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "sass": "^1.97.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
